{
  "name": "use-trpc",
  "version": "2.0.0-beta.1",
  "description": "Vue composable for tRPC v10",
  "repository": "github:aphex/use-trpc",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "unbuild",
    "test": "vitest run"
  },
  "keywords": [
    "trpc",
    "vue",
    "composable",
    "reactive"
  ],
  "author": "Ross Gerbasi",
  "license": "ISC",
  "dependencies": {
    "@trpc/client": "^11.1.2",
    "@trpc/server": "^11.1.2",
    "vue-demi": "*"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "@vue/shared": "^3.5.13",
    "happy-dom": "^17.4.7",
    "unbuild": "^3.5.0",
    "vitest": "^3.1.3",
    "ws": "^8.18.2",
    "zod": "^3.24.4"
  },
  "workspaces": [
    ".",
    "examples/**/*"
  ],
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "vue"
      ]
    }
  }
}
